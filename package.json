{
  "name": "longshot",
  "version": "0.2.0",
  "description": "Long-running goal based task management on Sail Research Sailboxes",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun src/cli.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile src/cli.ts --outfile dist/longshot",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@sailresearch/sdk": "0.17.1",
    "citty": "0.2.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
